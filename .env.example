# KAI Work Host reads process environment directly. Windows deployment normally
# generates config/work-host.local.json instead of copying this file.
KAI_WORK_HOST_BIND=127.0.0.1
KAI_WORK_HOST_PORT=8787
# KAI_WORK_HOST_HOME=C:\KAI-Data\WorkHost\instances\example
# KAI_WORK_HOST_CODEX_HOME=C:\KAI-Data\WorkHost\instances\example\codex
# The installer selects the pinned official Codex package inside the app tree.
# KAI_WORK_HOST_CODEX_CLI=C:\KAI-Data\WorkHost\app\0.4.0\node_modules\@openai\codex\bin\codex.js
KAI_WORK_HOST_WORKER_MODEL=gpt-5.6-luna
KAI_WORK_HOST_WORKER_EFFORT=high
KAI_WORK_HOST_EXECUTION_PROFILE=lean
KAI_WORK_HOST_RUNTIME_STARTUP_MS=120000
KAI_WORK_HOST_RUNTIME_TURN_MS=1800000
KAI_WORK_HOST_CONTEXT_CHARS=12000
KAI_WORK_HOST_EVENT_BATCH=40

# Set to 0 if the OAuth helper should print the URL without opening the default browser.
# KAI_WORK_HOST_OPEN_BROWSER=0

# Required only for a deliberately authorized non-loopback bind. Never commit a real value.
# KAI_WORK_HOST_BEARER_TOKEN=
